# Artillery product branding - after vendor logo, before version line.
# Plain text only: framebuffer tty0 does not render ANSI colors.
if command -v figlet >/dev/null 2>&1; then
	FONT=term
	figlet -f term -v >/dev/null 2>&1 || FONT=small
	printf '%s\n' "$(figlet -f "$FONT" 'A3D M1 Pro X1')"
else
	printf '   A3D M1 Pro X1\n'
fi
printf '\n'
