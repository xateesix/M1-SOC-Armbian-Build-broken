// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree Source for Rockchip RK3308B-S EVB Analog MIC V11
 *
 * Board connectors (as described by the owner):
 *   ┌─────────────────────────────────────────────────────────────────┐
 *   │  USB Type-C OTG    → ff400000 dwc2,  dr_mode = "otg"           │
 *   │  2× USB-A 5V host  → ff440000 EHCI + ff450000 OHCI             │
 *   │                      VBUS enable: GPIO0_C5 (active-high)        │
 *   │  24V power input   → external buck converter, no DTS needed     │
 *   │  LED +/−           → GPIO0_A6 (green/power), GPIO0_A5 (blue)   │
 *   │  3-pin RGB         → placeholder: see commented section below   │
 *   │  Serial + jumper   → UART3 @ 1500000 baud (ttyS3), OTG jumper  │
 *   │                      switches USB-C between ADB and serial mode  │
 *   │  40-pin FPC        → 4.3″ 480×272 RGB LCD via VOP               │
 *   │  FPC (remote)      → Goodix GT911 capacitive touch on I2C3      │
 *   │  microSD slot      → ff480000 SDMMC                             │
 *   └─────────────────────────────────────────────────────────────────┘
 *
 * GPIO CONFLICT NOTES (from factory DTS analysis):
 *   GPIO0_A2 is shared between WiFi reset (sdio-pwrseq) AND the
 *   headphone amp control (acodec hp-ctl-gpios) in the OEM firmware.
 *   This DTS disables hp-ctl-gpios to avoid the conflict; if you do
 *   not use WiFi, you can re-enable it.
 *
 *   GPIO0_A5 is shared between the blue heartbeat LED AND the speaker
 *   control (acodec spk-ctl-gpios). Speaker control is commented out
 *   below — enable it only if you remove the heartbeat LED trigger.
 */

/dts-v1/;
#include "rk3308.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/pwm/pwm.h>

/ {
	model = "Rockchip RK3308B-S EVB Analog MIC V11";
	compatible = "rockchip,rk3308bs-evb-amic-v11", "rockchip,rk3308";

	aliases {
		ethernet0 = &gmac;
		mmc0      = &emmc;
		mmc1      = &sdmmc;
		mmc2      = &sdio;
		serial0   = &uart0;
		serial1   = &uart1;
		serial2   = &uart2;
		serial3   = &uart3;
		serial4   = &uart4;
	};

	chosen {
		/*
		 * UART3 is the hardware debug serial port.
		 * The board has a jumper to switch this connector between
		 * normal serial (this stdout) and USB OTG mode.
		 */
		stdout-path = "serial3:1500000n8";
		bootargs = "earlycon=uart8250,mmio32,0xff0d0000 console=ttyS3,1500000n8 root=PARTUUID=614e0000-0000-4b53-8000-1d28000054a9 rootfstype=ext4 rw rootwait";
	};

	memory@0 {
		device_type = "memory";
		/*
		 * 512 MB — U-Boot/ATF will override this at boot time via
		 * FDT fixup, but a sane default is required by some paths.
		 * Change to 0x10000000 for 256 MB or 0x40000000 for 1 GB.
		 */
		reg = <0x00000000 0x00000000 0x00000000 0x20000000>;
	};

	/* ── CPU core voltage (PWM8 @ ff180000, inverted, 827–1340 mV) ── */
	vdd_core: vdd-core {
		compatible = "pwm-regulator";
		pwms = <&pwm8 0 5000 PWM_POLARITY_INVERTED>;
		regulator-name = "vdd_core";
		regulator-min-microvolt = <827000>;
		regulator-max-microvolt = <1340000>;
		regulator-init-microvolt = <1015000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
	};

	/* ── Fixed voltage rails ──────────────────────────────────────── */
	vcc_io: vcc-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_io";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_io>;
	};

	vdd_log: vdd-log {
		compatible = "regulator-fixed";
		regulator-name = "vdd_log";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	/* ── USB Host VBUS (GPIO0_C5, active-high) ──────────────────── */
	vbus_host: vbus-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_drv>;
		vin-supply = <&vcc_sys>;
		regulator-name = "vbus_host";
		regulator-boot-on;
	};

	/* ── Onboard GPIO LEDs ────────────────────────────────────────── */
	/*
	 * Physical LED +/− connector on the board routes to these same GPIOs.
	 * NOTE: GPIO0_A5 (blue) is shared with the acodec speaker control in
	 * the OEM firmware. See spk-ctl-gpios comment in the &acodec section.
	 */
	leds: leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_green_gpio>, <&led_blue_gpio>;

		led-power {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "default-on";
			default-state = "on";
		};

		led-user {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	/*
	 * ── 3-pin RGB connector placeholder ──────────────────────────────
	 *
	 * The board has a 3-pin RGB LED header. Three options:
	 *
	 * Option A — PWM-driven common-cathode RGB (PWM4/5/6 on GPIO0_A1,
	 *            GPIO0_B1, GPIO0_B2 respectively). Uncomment & enable the
	 *            matching &pwm4/5/6 nodes at the bottom of this file.
	 *
	 * rgb_leds: rgb-leds {
	 *     compatible = "pwm-leds";
	 *     led-red {
	 *         pwms = <&pwm4 0 10000 0>;
	 *         max-brightness = <255>;
	 *         color = <LED_COLOR_ID_RED>;
	 *     };
	 *     led-green {
	 *         pwms = <&pwm5 0 10000 0>;
	 *         max-brightness = <255>;
	 *         color = <LED_COLOR_ID_GREEN>;
	 *     };
	 *     led-blue {
	 *         pwms = <&pwm6 0 10000 0>;
	 *         max-brightness = <255>;
	 *         color = <LED_COLOR_ID_BLUE>;
	 *     };
	 * };
	 *
	 * Option B — WS2812/NeoPixel single-wire (needs SPI or dedicated driver).
	 * Option C — GPIO-only (add to gpio-leds above).
	 */

	/* ── LCD backlight (PWM9 @ ff180010) ─────────────────────────── */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm9 0 25000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <200>;
		power-supply = <&vcc_sys>;
	};

	/*
	 * ── 40-pin FPC: 4.3-inch 480×272 RGB LCD ──────────────────────
	 * Timings derived from factory DTS "timing3" (native-mode).
	 * enable-gpios: GPIO1_A3 active-low (PCB inverter on enable line)
	 * reset-gpios:  GPIO0_C4 active-low  (standard RST# active-low)
	 */
	panel: panel {
		compatible = "simple-panel";
		bus-format = <0x100a>;		/* MEDIA_BUS_FMT_RGB888_1X24 */
		backlight = <&backlight>;
		enable-gpios = <&gpio1 RK_PA3 GPIO_ACTIVE_LOW>;
		enable-delay-ms = <20>;
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
		reset-delay-ms = <10>;
		status = "okay";

		display-timings {
			native-mode = <&timing_4_3>;

			/* 4.3-inch 480×272 @ ~9 MHz — from factory DTS timing3 */
			timing_4_3: timing0 {
				clock-frequency = <9000000>;
				hactive      = <480>;
				vactive      = <272>;
				hback-porch  = <43>;
				hfront-porch = <8>;
				vback-porch  = <12>;
				vfront-porch = <8>;
				hsync-len    = <4>;
				vsync-len    = <4>;
				hsync-active    = <1>;
				vsync-active    = <1>;
				de-active       = <1>;
				pixelclk-active = <1>;
			};
		};

		port {
			panel_in_rgb: endpoint {
				remote-endpoint = <&rgb_out_panel>;
			};
		};
	};

	/*
	 * Internal RGB/LCDC output bridge (rockchip,rk3308-rgb).
	 * The active rk3308.dtsi does not define an `rgb` label, so this node
	 * must be declared inline for vop -> rgb -> panel routing.
	 */
	rgb: rgb {
		compatible = "rockchip,rk3308-rgb";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&lcdc_ctl>, <&lcdc_rgb888_m0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				rgb_in_vop: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vop_out_rgb>;
				};
			};

			port@1 {
				reg = <1>;

				rgb_out_panel: endpoint {
					remote-endpoint = <&panel_in_rgb>;
				};
			};
		};
	};

	/* ── WiFi power-sequence (RTL8189CS on SDIO) ─────────────────── */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		/* GPIO0_A2 active-low: WiFi chip RESET# */
		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <200>;
	};

	/* ── ADC buttons (SAR-ADC ch1) ────────────────────────────────── */
	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		poll-interval = <100>;
		keyup-threshold-microvolt = <1800000>;

		key-micmute {
			linux,code = <KEY_MICMUTE>;
			label = "micmute";
			press-threshold-microvolt = <1130000>;
		};
		key-mode {
			linux,code = <KEY_MODE>;
			label = "mode";
			press-threshold-microvolt = <900000>;
		};
		key-play {
			linux,code = <KEY_PLAYPAUSE>;
			label = "play";
			press-threshold-microvolt = <624000>;
		};
		key-vol-down {
			linux,code = <KEY_VOLUMEDOWN>;
			label = "volume down";
			press-threshold-microvolt = <300000>;
		};
		key-vol-up {
			linux,code = <KEY_VOLUMEUP>;
			label = "volume up";
			press-threshold-microvolt = <18000>;
		};
	};
};

/*
 * ── RK3308BS: CPU OPP cap at 1104 MHz ────────────────────────────────
 * The BS variant cannot run at the 1200/1296 MHz OPPs of standard RK3308.
 */
&cpu0_opp_table {
	/delete-node/ opp-1200000000;
	/delete-node/ opp-1296000000;

	/* RK3308BS maximum operating point */
	opp-1104000000 {
		opp-hz = /bits/ 64 <1104000000>;
		opp-microvolt = <1200000 1200000 1200000>;
		clock-latency-ns = <40000>;
	};
};

/* ── eMMC (8-bit HS200, non-removable) ───────────────────────────────── */
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	no-sdio;
	no-sd;
	disable-wp;
	num-slots = <1>;
	vmmc-supply  = <&vcc_io>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* ── microSD card slot ────────────────────────────────────────────────── */
&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	supports-sd;
	disable-wp;
	vmmc-supply = <&vcc_io>;
	status = "okay";
};

/* ── SDIO — WiFi RTL8189CS ────────────────────────────────────────────── */
&sdio {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	supports-sdio;
	mmc-pwrseq = <&sdio_pwrseq>;
	rockchip,default-sample-phase = <90>;
	max-frequency = <50000000>;
	status = "okay";
};

/* ── UART3: debug/console serial port ────────────────────────────────── */
&uart3 {
	status = "okay";
};

/* ── UART0: Bluetooth (with hardware flow control) ────────────────────── */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_xfer>, <&uart0_rts>, <&uart0_cts>;
	status = "okay";
};

/*
 * ── I2C3: Goodix GT911 capacitive touch (remote ribbon cable) ──────────
 * Keep GPIO semantics aligned with the factory tree to avoid probe issues.
 */
&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;

	touchscreen@5d {
		compatible = "goodix,gt911";
		reg = <0x5d>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_EDGE_RISING>;
		irq-gpios   = <&gpio0 RK_PB0 4>;
		reset-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
		max-x = <800>;
		max-y = <480>;
		tp-size = <109>;
		status = "okay";
	};
};

/* ── USB Type-C OTG port (dwc2 ff400000) ─────────────────────────────── */
&usb20_otg {
	dr_mode = "otg";
	status = "okay";
};

/* ── USB Host EHCI (first of 2× USB-A 5V ports) ──────────────────────── */
&usb_host_ehci {
	status = "okay";
};

/* ── USB Host OHCI (second of 2× USB-A 5V ports) ─────────────────────── */
&usb_host_ohci {
	status = "okay";
};

/* ── USB 2.0 PHY ──────────────────────────────────────────────────────── */
&u2phy {
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vbus_host>;
	status = "okay";
};

/* ── Display: VOP -> RGB bridge -> panel ────────────────────────────────── */
&vop {
	status = "okay";
};

&vop_out {
	#address-cells = <1>;
	#size-cells = <0>;

	vop_out_rgb: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&rgb_in_vop>;
	};
};

&display_subsystem {
	status = "okay";
};

/*
 * ── Internal RK3308 codec (analog MIC + headphone + speaker) ───────────
 * spk-ctl-gpios on GPIO0_A5 and hp-ctl-gpios on GPIO0_A2 are omitted due to
 * LED / WiFi GPIO conflicts (see header comments).
 */
&codec {
	rockchip,no-deep-low-power;
	rockchip,micbias1;
	rockchip,micbias2;
	status = "okay";
	#sound-dai-cells = <0>;
};

&i2s_8ch_2 {
	status = "okay";
};

/ {
	analog_sound: analog-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,rk3308-acodec";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,codec-hp-det;
		simple-audio-card,widgets = "Headphone", "Headphones";

		simple-audio-card,dai-link@0 {
			format = "i2s";

			cpu {
				sound-dai = <&i2s_8ch_2>;
			};

			codec {
				sound-dai = <&codec>;
			};
		};
	};
};

/* ── IO voltage domains ────────────────────────────────────────────────── */
&io_domains {
	vccio0-supply = <&vcc_io>;
	vccio1-supply = <&vcc_io>;
	vccio2-supply = <&vcc_io>;
	vccio3-supply = <&vcc_1v8>;	/* eMMC interface at 1.8 V */
	vccio4-supply = <&vcc_io>;
	vccio5-supply = <&vcc_io>;
	status = "okay";
};

/* ── Thermal shutdown / throttle ─────────────────────────────────────── */
&tsadc {
	compatible = "rockchip,rk3308bs-tsadc";
	rockchip,hw-tshut-temp   = <120000>;
	rockchip,hw-tshut-mode     = <0>;	/* mode 0 = CRU reset */
	rockchip,hw-tshut-polarity = <1>;	/* active-high */
	status = "okay";
};

/ {
	rockchip-system-monitor {
		compatible = "rockchip,system-monitor";
		rockchip,thermal-zone = "soc-thermal";
		rockchip,polling-delay = <200>;
	};

	thermal-zones {
		soc-thermal {
			polling-delay-passive = <20>;
			polling-delay = <1000>;
			sustainable-power = <360>;
			thermal-sensors = <&tsadc 0>;

			trips {
				soc_passive: trip-point@0 {
					temperature = <70000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_alert: trip-point@1 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				soc_crit: soc-crit {
					temperature = <115000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&soc_alert>;
					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
					contribution = <1000>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&tsadc 1>;
		};
	};
};

/* ── SAR ADC (ADC key buttons on channel 1) ──────────────────────────── */
&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

/* ── PWM8 (ff180000) — CPU VDD core regulator ─────────────────────────── */
&pwm8 {
	status = "okay";
	pinctrl-names = "active";
	pinctrl-0 = <&pwm8_pin_pull_down>;
};

/* ── PWM9 (ff180010) — LCD backlight ──────────────────────────────────── */
&pwm9 {
	status = "okay";
	pinctrl-names = "active";
	pinctrl-0 = <&pwm9_pin>;
};

/*
 * ── PWM4/5/6 (ff170000–010–020) — optional RGB LED connector ───────────
 * Uncomment these if using PWM-driven RGB LED on the 3-pin connector.
 * Also uncomment the rgb_leds node in the root node above.
 *
 * &pwm4 { status = "okay"; };
 * &pwm5 { status = "okay"; };
 * &pwm6 { status = "okay"; };
 */

/* ── Pinctrl: board-specific pin assignments ─────────────────────────── */
&pinctrl {
	usb {
		/* GPIO0_C5 = USB host VBUS enable */
		usb_drv: usb-drv {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sdio-pwrseq {
		/* GPIO0_A2 = WiFi RESET# (active-low) */
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		/* GPIO0_A0 = WiFi WAKE_HOST interrupt */
		wifi_wake_host: wifi-wake-host {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	leds {
		led_green_gpio: led-green-gpio {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		led_blue_gpio: led-blue-gpio {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
