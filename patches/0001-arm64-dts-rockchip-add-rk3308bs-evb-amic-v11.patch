From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: Armbian User <user@localhost>
Date: Mon, 09 Jun 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: rockchip: add RK3308B-S EVB Analog MIC V11 board

Add device tree support for the Rockchip RK3308B-S EVB Analog MIC V11
board (compatible: rockchip,rk3308bs-evb-amic-v11).

Hardware summary:
  - SoC:     Rockchip RK3308BS (4x Cortex-A35, max 1104 MHz)
  - RAM:     512 MB DDR3
  - Storage: eMMC (8-bit HS200) + microSD slot
  - WiFi:    RTL8189CS via SDIO (GPIO0_A2 reset, GPIO0_A0 wake)
  - BT:      via UART0 with hardware flow control
  - USB:     USB2 OTG (Type-C, dwc2) + 2x USB2 Host (EHCI/OHCI)
  - Display: 4.3" 480x272 RGB panel (VOP + RGB bridge, PWM9 backlight)
  - Touch:   Goodix GT911 capacitive on I2C3 (remote ribbon FPC)
  - Audio:   Internal RK3308 ACODEC (analog MIC, HP, speaker)
  - Console: UART3 @ 1500000 baud

Signed-off-by: Armbian User <user@localhost>
---
 arch/arm64/boot/dts/rockchip/Makefile                   |   1 +
 arch/arm64/boot/dts/rockchip/rk3308bs-evb-amic-v11.dts | 357 +++++++++++++++++
 2 files changed, 358 insertions(+)
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3308bs-evb-amic-v11.dts

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index 1111111..2222222 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -60,6 +60,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-evb.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-rock-pi-s.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-rock-pi-s-v11.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-rock-pi-s-v13.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308bs-evb-amic-v11.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3328-a1.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3328-evb.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3328-nanopi-r2c.dtb

diff --git a/arch/arm64/boot/dts/rockchip/rk3308bs-evb-amic-v11.dts b/arch/arm64/boot/dts/rockchip/rk3308bs-evb-amic-v11.dts
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3308bs-evb-amic-v11.dts
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree Source for Rockchip RK3308B-S EVB Analog MIC V11
+ *
+ * Board connectors:
+ *   USB Type-C OTG    → ff400000 dwc2,  dr_mode = "otg"
+ *   2× USB-A 5V host  → ff440000 EHCI + ff450000 OHCI
+ *                        VBUS enable: GPIO0_C5 (active-high)
+ *   24V power input   → external buck converter, no DTS needed
+ *   LED +/−           → GPIO0_A6 (green/power), GPIO0_A5 (blue)
+ *   3-pin RGB         → placeholder, see commented section
+ *   Serial + jumper   → UART3 @ 1500000 baud (ttyS3)
+ *   40-pin FPC        → 4.3″ 480×272 RGB LCD via VOP
+ *   FPC (remote)      → Goodix GT911 capacitive touch on I2C3
+ *   microSD slot      → ff480000 SDMMC
+ *
+ * GPIO CONFLICT NOTES:
+ *   GPIO0_A2 is shared between WiFi reset and acodec hp-ctl-gpios.
+ *   GPIO0_A5 is shared between blue LED and acodec spk-ctl-gpios.
+ *   Both conflicts are documented with comments at the relevant nodes.
+ */
+
+/dts-v1/;
+#include "rk3308.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/pwm/pwm.h>
+
+/ {
+	model = "Rockchip RK3308B-S EVB Analog MIC V11";
+	compatible = "rockchip,rk3308bs-evb-amic-v11", "rockchip,rk3308";
+
+	aliases {
+		ethernet0 = &gmac;
+		mmc0      = &emmc;
+		mmc1      = &sdmmc;
+		mmc2      = &sdio;
+		serial0   = &uart0;
+		serial1   = &uart1;
+		serial2   = &uart2;
+		serial3   = &uart3;
+		serial4   = &uart4;
+	};
+
+	chosen {
+		stdout-path = "serial3:1500000n8";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x00000000 0x00000000 0x20000000>;
+	};
+
+	vdd_core: vdd-core {
+		compatible = "pwm-regulator";
+		pwms = <&pwm8 0 5000 PWM_POLARITY_INVERTED>;
+		regulator-name = "vdd_core";
+		regulator-min-microvolt = <827000>;
+		regulator-max-microvolt = <1340000>;
+		regulator-init-microvolt = <1015000>;
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-settling-time-up-us = <250>;
+	};
+
+	vcc_io: vcc-io {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_io";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+	};
+
+	vcc_1v8: vcc-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_1v8";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		vin-supply = <&vcc_io>;
+	};
+
+	vdd_log: vdd-log {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_log";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+	};
+
+	vcc_sys: vcc-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+
+	vbus_host: vbus-host {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_drv>;
+		vin-supply = <&vcc_sys>;
+		regulator-name = "vbus_host";
+		regulator-boot-on;
+	};
+
+	leds: leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&led_green_gpio>, <&led_blue_gpio>;
+
+		led-power {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "default-on";
+			default-state = "on";
+		};
+
+		led-user {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_HEARTBEAT;
+			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+
+	/* 3-pin RGB connector: uncomment pwm-leds node here if needed */
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pwm9 0 25000 0>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <200>;
+		power-supply = <&vcc_sys>;
+	};
+
+	panel: panel {
+		compatible = "simple-panel";
+		bus-format = <0x100a>;
+		backlight = <&backlight>;
+		enable-gpios = <&gpio1 RK_PA3 GPIO_ACTIVE_LOW>;
+		enable-delay-ms = <20>;
+		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
+		reset-delay-ms = <10>;
+		status = "okay";
+
+		display-timings {
+			native-mode = <&timing_4_3>;
+
+			timing_4_3: timing0 {
+				clock-frequency = <9000000>;
+				hactive      = <480>;
+				vactive      = <272>;
+				hback-porch  = <43>;
+				hfront-porch = <8>;
+				vback-porch  = <12>;
+				vfront-porch = <8>;
+				hsync-len    = <4>;
+				vsync-len    = <4>;
+				hsync-active    = <1>;
+				vsync-active    = <1>;
+				de-active       = <1>;
+				pixelclk-active = <1>;
+			};
+		};
+
+		port {
+			panel_in_rgb: endpoint {
+				remote-endpoint = <&rgb_out_panel>;
+			};
+		};
+	};
+
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <200>;
+	};
+
+	adc-keys {
+		compatible = "adc-keys";
+		io-channels = <&saradc 1>;
+		io-channel-names = "buttons";
+		poll-interval = <100>;
+		keyup-threshold-microvolt = <1800000>;
+
+		key-micmute {
+			linux,code = <KEY_MICMUTE>;
+			label = "micmute";
+			press-threshold-microvolt = <1130000>;
+		};
+		key-mode {
+			linux,code = <KEY_MODE>;
+			label = "mode";
+			press-threshold-microvolt = <900000>;
+		};
+		key-play {
+			linux,code = <KEY_PLAYPAUSE>;
+			label = "play";
+			press-threshold-microvolt = <624000>;
+		};
+		key-vol-down {
+			linux,code = <KEY_VOLUMEDOWN>;
+			label = "volume down";
+			press-threshold-microvolt = <300000>;
+		};
+		key-vol-up {
+			linux,code = <KEY_VOLUMEUP>;
+			label = "volume up";
+			press-threshold-microvolt = <18000>;
+		};
+	};
+
+	acodec_sound: acodec-sound {
+		compatible = "rockchip,multicodecs-card";
+		rockchip,card-name = "rockchip,rk3308-acodec";
+		rockchip,codec-hp-det;
+		rockchip,mclk-fs = <256>;
+		rockchip,cpu   = <&i2s2>;
+		rockchip,codec = <&acodec>;
+		status = "okay";
+	};
+};
+
+&cpu0_opp_table {
+	/delete-node/ opp-1200000000;
+	/delete-node/ opp-1296000000;
+
+	opp-1104000000 {
+		opp-hz = /bits/ 64 <1104000000>;
+		opp-microvolt = <1200000 1200000 1200000>;
+		clock-latency-ns = <40000>;
+	};
+};
+
+&emmc {
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	mmc-hs200-1_8v;
+	non-removable;
+	no-sdio;
+	no-sd;
+	disable-wp;
+	num-slots = <1>;
+	vmmc-supply  = <&vcc_io>;
+	vqmmc-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&sdmmc {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	supports-sd;
+	disable-wp;
+	vmmc-supply = <&vcc_io>;
+	status = "okay";
+};
+
+&sdio {
+	bus-width = <4>;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+	non-removable;
+	supports-sdio;
+	mmc-pwrseq = <&sdio_pwrseq>;
+	rockchip,default-sample-phase = <90>;
+	max-frequency = <50000000>;
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_xfer>, <&uart0_rts>, <&uart0_cts>;
+	status = "okay";
+};
+
+&i2c3 {
+	status = "okay";
+
+	touchscreen@5d {
+		compatible = "goodix,gt911";
+		reg = <0x5d>;
+		interrupt-parent = <&gpio0>;
+		interrupts = <RK_PB0 IRQ_TYPE_EDGE_RISING>;
+		irq-gpios   = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_LOW>;
+		touchscreen-size-x = <480>;
+		touchscreen-size-y = <272>;
+		status = "okay";
+	};
+};
+
+&usb20_otg {
+	dr_mode = "otg";
+	status = "okay";
+};
+
+&usb_host_ehci {
+	status = "okay";
+};
+
+&usb_host_ohci {
+	status = "okay";
+};
+
+&u2phy {
+	status = "okay";
+};
+
+&u2phy_otg {
+	status = "okay";
+};
+
+&u2phy_host {
+	phy-supply = <&vbus_host>;
+	status = "okay";
+};
+
+&vop {
+	status = "okay";
+};
+
+&rgb {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&lcdc_ctl>, <&lcdc_rgb888_m0>;
+};
+
+&rgb_out {
+	remote-endpoint = <&panel_in_rgb>;
+};
+
+&acodec {
+	rockchip,no-deep-low-power;
+	rockchip,micbias1;
+	rockchip,micbias2;
+	/* spk-ctl-gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>; conflicts with led-user */
+	/* hp-ctl-gpios  = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>; conflicts with WiFi reset */
+	status = "okay";
+};
+
+&i2s2 {
+	#sound-dai-cells = <0>;
+	status = "okay";
+};
+
+&io_domains {
+	vccio0-supply = <&vcc_io>;
+	vccio1-supply = <&vcc_io>;
+	vccio2-supply = <&vcc_io>;
+	vccio3-supply = <&vcc_1v8>;
+	vccio4-supply = <&vcc_io>;
+	vccio5-supply = <&vcc_io>;
+	status = "okay";
+};
+
+&tsadc {
+	rockchip,hw-tshut-mode     = <0>;
+	rockchip,hw-tshut-polarity = <1>;
+	status = "okay";
+};
+
+&saradc {
+	vref-supply = <&vcc_1v8>;
+	status = "okay";
+};
+
+&pwm8 {
+	status = "okay";
+	pinctrl-names = "active";
+	pinctrl-0 = <&pwm8_pin_pull_down>;
+};
+
+&pwm9 {
+	status = "okay";
+	pinctrl-names = "active";
+	pinctrl-0 = <&pwm9_pin>;
+};
+
+&pinctrl {
+	usb {
+		usb_drv: usb-drv {
+			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	sdio-pwrseq {
+		wifi_enable_h: wifi-enable-h {
+			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	wireless-wlan {
+		wifi_wake_host: wifi-wake-host {
+			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
+	leds {
+		led_green_gpio: led-green-gpio {
+			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+		led_blue_gpio: led-blue-gpio {
+			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+};
-- 
2.39.0
