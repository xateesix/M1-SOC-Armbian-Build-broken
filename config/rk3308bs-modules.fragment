# RK3308BS display: rockchipdrm as module (avoids __run_timers panic on 2nd boot).
# ROCKCHIP_VOP / ROCKCHIP_RGB are Kconfig bool (y/n only — never =m).
# RGB code lives inside rockchipdrm.ko; without ROCKCHIP_RGB=y the 480x272 panel stays blank.
CONFIG_DRM_ROCKCHIP=m
CONFIG_ROCKCHIP_VOP=y
# CONFIG_ROCKCHIP_VOP2 is not set
CONFIG_ROCKCHIP_RGB=y
CONFIG_DRM_PANEL_SIMPLE=m
CONFIG_BACKLIGHT_PWM=m
CONFIG_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
