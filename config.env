# =============================================================================
# RK3308BS Armbian Build Configuration
# =============================================================================
# Edit the values in this file ONCE, then use them for all future builds
# 
# Reference:
#   - QUICKSTART.md - Get started in 3 steps
#   - README.md     - Complete documentation
#   - IMPROVEMENTS.md - What changed from old build system
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────
# 🔌 BUILD SERVER (Ubuntu machine where Armbian is compiled)
# ─────────────────────────────────────────────────────────────────────────

# Hostname or IP address of your Ubuntu build machine
BUILD_SERVER_HOST="ubuntu-server"

# SSH login username on build server
BUILD_SERVER_USER="xateesix"

# Path on build server where Armbian will be installed & cached
# This becomes permanent, reused across all future builds
BUILD_SERVER_PATH="/home/xateesix/armbian-build"

# Note: All files are cached here, so 2nd+ builds only take ~25 mins
#       vs 45-90 mins for first build (downloading toolchains)

# ─────────────────────────────────────────────────────────────────────────
# 📡 WiFi CONFIGURATION (Pre-baked into the image)
# ─────────────────────────────────────────────────────────────────────────

# Your WiFi network name (SSID)
# The board will connect to this automatically on first boot
WIFI_SSID="OurIOT"

# WiFi password (WPA2-PSK)
# ⚠️  Avoid special chars that break bash: $, `, \, ", '
#    Use alphanumerics, #, @, !, -, _, =, +, etc.
WIFI_PASSWORD="mNhTYTeh#p3LnRw^Ln*N3VwiD"

# ─────────────────────────────────────────────────────────────────────────
# 🔐 ROOT PASSWORD (Set automatically during build)
# ─────────────────────────────────────────────────────────────────────────

# Root password for Linux login
# No interactive prompt on first boot - direct SSH access
# Change anytime after boot: `sudo passwd root`
ROOT_PASSWORD="ztfalxtspv"

# ─────────────────────────────────────────────────────────────────────────
# 📦 ARMBIAN BUILD SETTINGS (Advanced - usually don't change)
# ─────────────────────────────────────────────────────────────────────────

# Ubuntu release for rootfs (jammy = 22.04 LTS, stable for rockchip64)
RELEASE="jammy"

# Kernel branch (current = latest LTS + Rockchip patches)
KERNEL_BRANCH="current"

# U-Boot bootloader defconfig (DO NOT CHANGE - verified for RK3308)
UBOOT_DEFCONFIG="evb-rk3308_defconfig"

# ─────────────────────────────────────────────────────────────────────────
# 🐙 GITHUB INTEGRATION (Optional - leave empty to skip)
# ─────────────────────────────────────────────────────────────────────────

# GitHub repository URL for syncing configs + build outputs
# Leave empty if you don't use GitHub
# Examples:
#   https://github.com/username/rk3308bs-armbian.git
#   git@github.com:username/rk3308bs-armbian.git
GITHUB_REPO=""

# To set up GitHub:
#   1. Create repo at https://github.com/new
#   2. Fill in GITHUB_REPO above with your URL
#   3. Run:  git init && git remote add origin $GITHUB_REPO
#   4. See GITHUB_SETUP.md for details

# =============================================================================
# ✅ READY TO BUILD?
# =============================================================================
# 
# 1. Edit this file and set your values above
# 2. Run:  chmod +x setup-validate.sh && ./setup-validate.sh
# 3. Run:  chmod +x build-enhanced.sh && ./build-enhanced.sh
# 4. Wait ~30 minutes for image
# 5. Flash to microSD with balenaEtcher
#
# See QUICKSTART.md for complete steps
# =============================================================================
